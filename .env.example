# Variables de entorno del Planificador de Actividades
# Copiar a .env y completar los valores. NUNCA subir .env a un repositorio publico.

# URL base del backend propio (auth y perfil).
API_BASE_URL=https://planificador-backend-fermar707501.fly.dev

# USE_MOCK_BACKEND=true usa datos simulados (auth/usuario sin backend).
# false apunta al backend real definido en API_BASE_URL.
# En tests (sin .env cargado) el valor por defecto es true (mock).
USE_MOCK_BACKEND=false

# API key de Google Maps (autocompletar direcciones + mapa).
GOOGLE_MAPS_API_KEY=

# API key del servicio de clima (OpenWeatherMap o WeatherAPI.com).
WEATHER_API_KEY=
